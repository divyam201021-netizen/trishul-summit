# ---------------------------------------------------------------------------
# Trishul Summit — environment template
# Copy to `.env` and fill in. Values that are still unknown MUST stay empty:
# the application renders a visible `[LABEL — TBD]` placeholder instead of a
# fabricated fact.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin, used for canonical URLs, email links and payment redirects.
APP_URL="http://localhost:3000"

# Relational database. SQLite ships as the zero-setup default for local and
# single-tenant deployments. For PostgreSQL/Supabase switch the provider in
# prisma/schema.prisma to "postgresql" and set a connection string, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/trishul?schema=public"
DATABASE_URL="file:./dev.db"

# 32+ byte random string. Signs participant/admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Rotating salt for analytics IP hashing (falls back to SESSION_SECRET).
ANALYTICS_SALT=""

# --- Identity & participant registry (Supabase) -----------------------------
# Registration is gated by Supabase Auth, and every answer an applicant submits
# is mirrored into the Trishul registry tables in this project.
# Only publishable values are needed: the registry is protected by row level
# security, so no service-role secret is required for the registration flow.
# The key is the "publishable" key from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Transactional email ----------------------------------------------------
# MAIL_TRANSPORT=log   -> messages are recorded in the database and logged (default)
# MAIL_TRANSPORT=smtp  -> requires the SMTP_* values below (raw SMTP, no SDK needed)
MAIL_TRANSPORT="log"
MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Payments ---------------------------------------------------------------
# Left empty on purpose: payment is NOT configured, checkout stays disabled and
# the UI surfaces "[PAYMENT DETAILS — TBD]".
# PAYMENT_PROVIDER=stripe|razorpay|custom
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- Bot / abuse protection -------------------------------------------------
# Optional Cloudflare Turnstile keys. When absent, the built-in honeypot +
# rate-limit + timing heuristics are used.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
