{
  "name": "trishul-summit",
  "version": "1.0.0",
  "private": true,
  "description": "Trishul Summit — online Model United Nations / summit platform: public event site, registration, participant portal and organizer workspace.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
